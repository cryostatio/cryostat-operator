{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    "helpers:pinGitHubActionDigestsToSemver",
    "docker:pinDigests",
    ":configMigration",
    ":docker",
    ":separateMajorReleases",
    ":separateMultipleMinorReleases",
    ":separatePatchReleases",
    ":gomod"
  ],
  "baseBranchPatterns": ["main", "/^cryostat-v.*/"],
  "reviewersFromCodeOwners": true,
  "labels": [
    "dependencies",
    "chore",
    "safe-to-test"
  ],
  "semanticCommits": "enabled",
  "major": {
    "dependencyDashboardApproval": true
  },
  "minor": {
    "dependencyDashboardApproval": true
  },
  "stopUpdatingLabel": "blocked",
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/\\.github/workflows/lint\\.yml$/"],
      "matchStrings": [
        "version: (?<currentValue>v\\S+)"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "golangci/golangci-lint"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^Makefile$/"],
      "matchStrings": [
        "GOLANGCI_LINT_VERSION \\?= (?<currentValue>\\S+)"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "golangci/golangci-lint",
      "extractVersionTemplate": "^v?(?<version>.*)$"
    },
    {
      "customType": "regex",
      "description": "Track the pinned tonistiigi/binfmt QEMU image passed to docker/setup-qemu-action, independently of the action's own pinned digest",
      "managerFilePatterns": ["/^\\.github/workflows/.+\\.ya?ml$/"],
      "matchStrings": [
        "image:\\s+mirror\\.gcr\\.io/tonistiigi/binfmt:(?<currentValue>qemu-v[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]+)"
      ],
      "depNameTemplate": "tonistiigi/binfmt",
      "datasourceTemplate": "docker",
      "versioningTemplate": "regex:^qemu-v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$"
    }
  ],
  "packageRules": [
    {
      "description": "Dockerfile base image updates are never gated by the dependency dashboard, on any branch",
      "matchManagers": ["dockerfile"],
      "dependencyDashboardApproval": false
    },
    {
      "description": "Disable all dependency updates on release branches except Dockerfile base images; other updates there are handled via Mergify backport",
      "matchBaseBranches": ["/^cryostat-v.*/"],
      "enabled": false
    },
    {
      "description": "Allow Dockerfile base image updates on release branches",
      "matchBaseBranches": ["/^cryostat-v.*/"],
      "matchManagers": ["dockerfile"],
      "enabled": true
    },
    {
      "description": "Allow go.mod updates on release branches so Renovate can classify their update type; non-patch updates are disabled below.",
      "matchBaseBranches": ["/^cryostat-v.*/"],
      "matchManagers": ["gomod"],
      "enabled": true,
      "dependencyDashboardApproval": false
    },
    {
      "description": "Disable non-patch go.mod updates on release branches",
      "matchBaseBranches": ["/^cryostat-v.*/"],
      "matchManagers": ["gomod"],
      "matchUpdateTypes": ["major", "minor", "digest", "pin", "pinDigest", "lockFileMaintenance", "rollback", "bump", "replacement"],
      "enabled": false
    },
    {
      "description": "Keep the go directive in go.mod up to date, since the gomod manager leaves it alone by default. go.mod is the single source of truth for the Go version; CI workflows read it via setup-go's go-version-file",
      "matchManagers": ["gomod"],
      "matchDepTypes": ["golang"],
      "rangeStrategy": "bump",
      "groupName": "go"
    },
    {
      "description": "Allow floating tags and disable digest pinning in kustomization image patches",
      "matchDatasources": ["docker"],
      "matchFileNames": [
        "config/*/kustomization.yaml"
      ],
      "pinDigests": false
    }
  ]
}
